# Copy to ~/.google-ads-cli/.env or point GOOGLE_ADS_CLI_CONFIG_DIR at a folder containing .env.

# Storage
GOOGLE_ADS_CLI_HOME=~/.google-ads-cli
GOOGLE_ADS_CLI_PG_DSN=postgresql:///google_ads_cli

# Google Ads API
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Account defaults used by planners and reports. Leave blank for no brand rules.
GOOGLE_ADS_BUSINESS_NAME=Your Business
GOOGLE_ADS_BRAND_TERMS=
GOOGLE_ADS_COMPETITOR_TERMS=
GOOGLE_ADS_TARGET_NCPA=70
GOOGLE_ADS_REPORT_TITLE=Google Ads Heartbeat
GOOGLE_ADS_OPERATOR_DASHBOARD_URL=

# Optional asset-default files. Values should be JSON dictionaries keyed by customer ID.
GOOGLE_ADS_PMAX_BRAND_ASSETS_FILE=
GOOGLE_ADS_PMAX_ASSET_GROUP_ASSETS_FILE=
GOOGLE_ADS_DEMAND_GEN_AD_ASSETS_FILE=

# Optional Slack live-mutation recap integration.
GOOGLE_ADS_SLACK_CHANNEL_ID=
GOOGLE_ADS_SLACK_HELPER=

# Optional audit integrations. Set the *_AUDIT_* flag to true only when configured.
GOOGLE_ADS_AUDIT_SCHEDULER=false
GOOGLE_ADS_DIRECT_HOURLY_LABELS=
GOOGLE_ADS_DIRECT_DAILY_LABELS=
GOOGLE_ADS_DIRECT_BOOTSTRAP_LABELS=
GOOGLE_ADS_REPORT_HOURLY_LABELS=
GOOGLE_ADS_ATTRIBUTION_HOURLY_LABELS=
GOOGLE_ADS_ATTRIBUTION_ROLLING_LABELS=

GOOGLE_ADS_AUDIT_DASHBOARD=false
GOOGLE_ADS_DASHBOARD_ROUTE_PATHS=
GOOGLE_ADS_DASHBOARD_DATA_PATHS=
GOOGLE_ADS_DASHBOARD_E2E_PATHS=

GOOGLE_ADS_AUDIT_SLACK_REPORT=false
GOOGLE_ADS_SOURCE_REGISTRY_PATHS=
